{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pi Research Agent analysis runtime request v1",
  "type": "object",
  "required": [
    "runtime",
    "script",
    "inputs",
    "parameters",
    "randomSeed"
  ],
  "properties": {
    "runtime": {
      "type": "string",
      "minLength": 1
    },
    "script": {
      "type": "object",
      "required": [
        "path",
        "hash",
        "mediaType",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/\\\\]+(?:/[^/\\\\]+)*$"
        },
        "hash": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "algorithm",
                "value"
              ],
              "properties": {
                "algorithm": {
                  "type": "string",
                  "const": "sha256"
                },
                "value": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "mediaType": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "hash",
          "mediaType",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/\\\\]+(?:/[^/\\\\]+)*$"
          },
          "hash": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "algorithm",
                  "value"
                ],
                "properties": {
                  "algorithm": {
                    "type": "string",
                    "const": "sha256"
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ]
          },
          "mediaType": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "bytes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "parameters": {
      "$defs": {
        "JsonValue": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "$ref": "JsonValue"
              }
            },
            {
              "type": "object",
              "patternProperties": {
                "^.*$": {
                  "$ref": "JsonValue"
                }
              }
            }
          ],
          "$id": "JsonValue"
        }
      },
      "$ref": "JsonValue"
    },
    "randomSeed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
