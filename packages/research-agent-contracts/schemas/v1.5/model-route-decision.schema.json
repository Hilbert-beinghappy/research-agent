{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pi Research Agent model route decision v1",
  "type": "object",
  "required": [
    "format",
    "version",
    "decisionId",
    "projectId",
    "requestHash",
    "selected",
    "evaluations",
    "decidedAt"
  ],
  "properties": {
    "format": {
      "type": "string",
      "const": "pi-research-model-route-decision"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "decisionId": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "requestHash": {
      "type": "object",
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": true
    },
    "selected": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "provider",
            "model",
            "local",
            "available",
            "capabilities",
            "contextWindow",
            "estimatedCost"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "local": {
              "type": "boolean"
            },
            "available": {
              "type": "boolean"
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "contextWindow": {
              "type": "integer",
              "minimum": 1
            },
            "estimatedCost": {
              "type": "object",
              "required": [
                "amount",
                "currency"
              ],
              "properties": {
                "amount": {
                  "type": "number",
                  "minimum": 0
                },
                "currency": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provider",
          "model",
          "eligible",
          "reasons"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "eligible": {
            "type": "boolean"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    },
    "decidedAt": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
