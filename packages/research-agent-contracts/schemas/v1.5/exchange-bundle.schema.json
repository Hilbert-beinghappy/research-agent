{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pi Research Agent exchange bundle v1",
  "type": "object",
  "required": [
    "format",
    "version",
    "bundleId",
    "projectId",
    "projectSchemaVersion",
    "projectRevision",
    "createdAt",
    "includesRawMaterials",
    "files",
    "excludedPaths",
    "requiredAdapters",
    "rootHash",
    "signature"
  ],
  "properties": {
    "format": {
      "type": "string",
      "const": "pi-research-exchange-bundle"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "bundleId": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "projectSchemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "projectRevision": {
      "type": "integer",
      "minimum": 0
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    },
    "includesRawMaterials": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "hash",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/\\\\]+(?:/[^/\\\\]+)*$"
          },
          "hash": {
            "type": "object",
            "required": [
              "algorithm",
              "value"
            ],
            "properties": {
              "algorithm": {
                "type": "string",
                "const": "sha256"
              },
              "value": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": true
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    },
    "excludedPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/\\\\]+(?:/[^/\\\\]+)*$"
      }
    },
    "requiredAdapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "packageId",
          "packageVersion",
          "packageHash",
          "manifestHash"
        ],
        "properties": {
          "packageId": {
            "type": "string",
            "minLength": 1
          },
          "packageVersion": {
            "type": "string",
            "minLength": 1
          },
          "packageHash": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "algorithm",
                  "value"
                ],
                "properties": {
                  "algorithm": {
                    "type": "string",
                    "const": "sha256"
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ]
          },
          "manifestHash": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "algorithm",
                  "value"
                ],
                "properties": {
                  "algorithm": {
                    "type": "string",
                    "const": "sha256"
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "rootHash": {
      "type": "object",
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": true
    },
    "signature": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "algorithm",
            "publicKey",
            "signature"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "ed25519"
            },
            "publicKey": {
              "type": "string",
              "minLength": 1
            },
            "signature": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true
}
