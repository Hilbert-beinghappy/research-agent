{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pi Research Agent analysis runtime result v1",
  "type": "object",
  "required": [
    "status",
    "outputs",
    "logs",
    "exitCode"
  ],
  "properties": {
    "status": {
      "anyOf": [
        {
          "type": "string",
          "const": "succeeded"
        },
        {
          "type": "string",
          "const": "failed"
        },
        {
          "type": "string",
          "const": "aborted"
        },
        {
          "type": "string",
          "const": "non_converged"
        }
      ]
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "hash",
          "mediaType",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/\\\\]+(?:/[^/\\\\]+)*$"
          },
          "hash": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "algorithm",
                  "value"
                ],
                "properties": {
                  "algorithm": {
                    "type": "string",
                    "const": "sha256"
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ]
          },
          "mediaType": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "bytes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "logs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "hash",
          "mediaType",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/\\\\]+(?:/[^/\\\\]+)*$"
          },
          "hash": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "algorithm",
                  "value"
                ],
                "properties": {
                  "algorithm": {
                    "type": "string",
                    "const": "sha256"
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ]
          },
          "mediaType": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "bytes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "exitCode": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
