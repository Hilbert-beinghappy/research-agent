{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pi Research Agent artifact adapter request v1",
  "type": "object",
  "required": [
    "artifactKind",
    "title",
    "sourceRecords",
    "sourceFiles",
    "options"
  ],
  "properties": {
    "artifactKind": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "sourceRecords": {
      "type": "array",
      "items": {
        "$defs": {
          "JsonValue": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "JsonValue"
                }
              },
              {
                "type": "object",
                "patternProperties": {
                  "^.*$": {
                    "$ref": "JsonValue"
                  }
                }
              }
            ],
            "$id": "JsonValue"
          }
        },
        "$ref": "JsonValue"
      }
    },
    "sourceFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "hash",
          "mediaType",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/\\\\]+(?:/[^/\\\\]+)*$"
          },
          "hash": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "algorithm",
                  "value"
                ],
                "properties": {
                  "algorithm": {
                    "type": "string",
                    "const": "sha256"
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ]
          },
          "mediaType": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "bytes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "options": {
      "$defs": {
        "JsonValue": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "$ref": "JsonValue"
              }
            },
            {
              "type": "object",
              "patternProperties": {
                "^.*$": {
                  "$ref": "JsonValue"
                }
              }
            }
          ],
          "$id": "JsonValue"
        }
      },
      "$ref": "JsonValue"
    }
  },
  "additionalProperties": false
}
