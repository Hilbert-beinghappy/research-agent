{
	"name": "@research-agent/contracts",
	"version": "2.0.0",
	"description": "Stable contracts for local-first research projects and adapters",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./adapter-protocol": "./src/adapter-protocol.ts",
		"./adapters": "./src/adapters.ts",
		"./canonical-json": "./src/canonical-json.ts",
		"./integrity": "./src/integrity.ts",
		"./schemas": "./src/schemas.ts",
		"./sdk-rpc": "./src/sdk-rpc.ts",
		"./validators": "./src/validators.ts"
	},
	"files": [
		"src",
		"schemas",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"check": "biome check src scripts test vitest.config.ts tsconfig.json && tsgo --noEmit -p tsconfig.json",
		"generate:schemas": "node scripts/generate-schemas.ts",
		"scan:release": "node scripts/scan-release.ts",
		"test": "vitest run test"
	},
	"dependencies": {
		"typebox": "1.3.7"
	},
	"devDependencies": {
		"@types/node": "24.12.4",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Hilbert-beinghappy/research-agent.git",
		"directory": "packages/research-agent-contracts"
	},
	"keywords": [
		"research-agent",
		"contracts",
		"adapter"
	],
	"license": "Apache-2.0"
}
