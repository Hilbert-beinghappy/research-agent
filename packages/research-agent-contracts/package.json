{
	"name": "@research-agent/contracts",
	"version": "2.1.0",
	"description": "Stable contracts for local-first research projects and adapters",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./adapter-protocol": {
			"types": "./dist/adapter-protocol.d.ts",
			"import": "./dist/adapter-protocol.js"
		},
		"./adapters": {
			"types": "./dist/adapters.d.ts",
			"import": "./dist/adapters.js"
		},
		"./canonical-json": {
			"types": "./dist/canonical-json.d.ts",
			"import": "./dist/canonical-json.js"
		},
		"./integrity": {
			"types": "./dist/integrity.d.ts",
			"import": "./dist/integrity.js"
		},
		"./memory": {
			"types": "./dist/memory.d.ts",
			"import": "./dist/memory.js"
		},
		"./memory-transfer": {
			"types": "./dist/memory-transfer.d.ts",
			"import": "./dist/memory-transfer.js"
		},
		"./memory-validators": {
			"types": "./dist/memory-validators.d.ts",
			"import": "./dist/memory-validators.js"
		},
		"./schemas": {
			"types": "./dist/schemas.d.ts",
			"import": "./dist/schemas.js"
		},
		"./sdk-rpc": {
			"types": "./dist/sdk-rpc.d.ts",
			"import": "./dist/sdk-rpc.js"
		},
		"./validators": {
			"types": "./dist/validators.d.ts",
			"import": "./dist/validators.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"schemas",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "biome check src scripts test vitest.config.ts tsconfig.json && tsgo --noEmit -p tsconfig.json",
		"clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
		"generate:schemas": "node scripts/generate-schemas.ts",
		"prepublishOnly": "npm run clean && npm run build",
		"scan:release": "npm run clean && npm run build && node scripts/scan-release.ts",
		"test": "vitest run test"
	},
	"dependencies": {
		"typebox": "1.3.7"
	},
	"devDependencies": {
		"@types/node": "24.12.4",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Hilbert-beinghappy/research-agent.git",
		"directory": "packages/research-agent-contracts"
	},
	"keywords": [
		"research-agent",
		"contracts",
		"adapter"
	],
	"license": "Apache-2.0"
}
