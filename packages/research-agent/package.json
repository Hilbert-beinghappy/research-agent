{
	"name": "pi-research-agent",
	"version": "2.0.1",
	"description": "Local-first, evidence-first research workflows for Pi",
	"type": "module",
	"main": "./dist/contracts/index.js",
	"types": "./dist/contracts/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/contracts/index.d.ts",
			"import": "./dist/contracts/index.js"
		},
		"./contracts": {
			"types": "./dist/contracts/index.d.ts",
			"import": "./dist/contracts/index.js"
		},
		"./adapter-protocol": {
			"types": "./dist/contracts/adapter-protocol.d.ts",
			"import": "./dist/contracts/adapter-protocol.js"
		},
		"./rpc": {
			"types": "./dist/rpc/index.d.ts",
			"import": "./dist/rpc/index.js"
		},
		"./sdk": {
			"types": "./dist/sdk/index.d.ts",
			"import": "./dist/sdk/index.js"
		},
		"./schemas/*": "./schemas/*",
		"./package.json": "./package.json"
	},
	"bin": {
		"research-agent-rpc": "./bin/research-agent-rpc.mjs"
	},
	"files": [
		"CHANGELOG.md",
		"bin",
		"CONTRIBUTING.md",
		"GOVERNANCE.md",
		"dist",
		"extensions",
		"skills",
		"prompts",
		"evals",
		"examples",
		"docs",
		"domains",
		"src",
		"schemas",
		"scripts",
		"test/fixtures/projects/scenario-a/topics.json",
		"README.md",
		"LICENSE",
		"NOTICE",
		"SBOM.spdx.json",
		"SECURITY.md",
		"THIRD_PARTY_NOTICES.md"
	],
	"scripts": {
		"benchmark:v0.1": "node scripts/benchmark-v0.1.ts",
		"benchmark:v0.2": "node scripts/benchmark-v0.2.ts",
		"benchmark:v0.3": "node scripts/benchmark-v0.3.ts",
		"benchmark:v0.4": "node scripts/benchmark-v0.4.ts",
		"benchmark:v0.5": "node scripts/benchmark-v0.5.ts",
		"benchmark:v1.0": "node scripts/benchmark-v1.0.ts",
		"benchmark:v1.1": "node scripts/benchmark-v1.1.ts",
		"benchmark:v1.5": "node scripts/benchmark-v1.5.ts",
		"benchmark:v2.0": "node scripts/benchmark-v2.0.ts",
		"build": "npm run build --workspace @research-agent/contracts && tsgo -p tsconfig.build.json",
		"check": "biome check extensions src scripts test vitest.config.ts tsconfig.build.json && node scripts/validate-memory-threat-model.ts && tsgo --noEmit -p tsconfig.json",
		"clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
		"conform:adapter": "node scripts/conform-adapter.ts",
		"diagnose:transactions": "node scripts/diagnose-project-transactions.ts",
		"generate:release-metadata": "node scripts/generate-release-metadata.ts",
		"generate:schemas": "node scripts/generate-schemas.ts",
		"eval": "node scripts/evaluate-v0.1.ts",
		"eval:v0.2": "node scripts/evaluate-v0.2.ts",
		"eval:v0.3": "node scripts/evaluate-v0.3.ts",
		"eval:v0.4": "node scripts/evaluate-v0.4.ts",
		"eval:v0.5": "node scripts/evaluate-v0.5.ts",
		"eval:v1.0": "node scripts/evaluate-v1.0.ts",
		"eval:v1.1": "node scripts/evaluate-v1.1.ts",
		"eval:v1.5": "node scripts/evaluate-v1.5.ts",
		"eval:v2.0": "node scripts/evaluate-v2.0.ts",
		"qualify:isolation:v1.5": "node scripts/qualify-v1.5-isolation.ts",
		"qualify:scenario-e:v2.0": "node scripts/qualify-v2.0-scenario-e.ts",
		"qualify:release:v2.0": "node scripts/qualify-v2.0-release.ts",
		"qualify:runtimes:v0.3": "node scripts/qualify-v0.3-runtimes.ts",
		"report:release-identity": "node scripts/report-release-identity.ts",
		"prepublishOnly": "npm run clean && npm run build",
		"test:unit": "vitest run test/unit test/contracts",
		"test:integration": "vitest run --dir test/integration",
		"test:e2e": "vitest run --dir test/e2e",
		"test:public-corpus": "RESEARCH_AGENT_PUBLIC_CORPUS=1 vitest run test/e2e/public-corpus-workflow.test.ts",
		"test:compat": "vitest run --dir test/compat",
		"test:clean-install": "node scripts/test-clean-install.ts",
		"test:clean-install:latest": "node scripts/test-clean-install.ts --pi-version 0.84.0",
		"scan:release": "npm run clean && npm run build && node scripts/generate-release-metadata.ts --check && node scripts/scan-release.ts",
		"validate:memory-threat-model": "node scripts/validate-memory-threat-model.ts",
		"validate:security-waivers": "node scripts/validate-security-waivers.ts"
	},
	"pi": {
		"extensions": [
			"./extensions/research.ts"
		],
		"skills": [
			"./skills"
		],
		"prompts": [
			"./prompts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@earendil-works/pi-coding-agent": "0.83.0",
		"@types/node": "24.12.4",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"vitest": "4.1.9"
	},
	"keywords": [
		"pi-package",
		"research",
		"evidence",
		"reproducibility"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Hilbert-beinghappy/research-agent.git",
		"directory": "packages/research-agent"
	},
	"license": "Apache-2.0",
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@research-agent/contracts": "2.0.0",
		"@citation-js/core": "0.8.2",
		"@citation-js/plugin-bibtex": "0.8.2",
		"@citation-js/plugin-ris": "0.8.2",
		"pdfjs-dist": "6.2.108"
	}
}
